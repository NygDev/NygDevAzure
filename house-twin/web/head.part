<title>Mallingsrudveien 30</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
:root{
  --bg:#E9EDEB; --panel:#F8FAF9; --ink:#1B2426; --muted:#5A6668; --faint:#8A9597;
  --line:#D2D9D7; --chip:#EEF2F1; --accent:#2D6C8C; --accent-soft:#D6E6EE; --accent-ink:#FFFFFF;
  --warn:#9A5F0C; --warn-soft:#F5E6CC; --ok:#2F6F45; --ok-soft:#D9EBDD; --info:#4F5B75; --info-soft:#E1E5EE; --doc:#6A4F86; --doc-soft:#E9E2F1;
  --scene:#E4E8E6; --label-bg:rgba(248,250,249,.92);
  --display:"Barlow Semi Condensed","Arial Narrow",system-ui,sans-serif;
  --body:"Barlow",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#0F1416; --panel:#151C1E; --ink:#E2E8E6; --muted:#98A5A4; --faint:#6D7A7A;
    --line:#293436; --chip:#1C2528; --accent:#72B4D4; --accent-soft:#1D3441; --accent-ink:#0C1417;
    --warn:#E3A84E; --warn-soft:#3A2C16; --ok:#7CC593; --ok-soft:#1B3223; --info:#A8B4D2; --info-soft:#22283A; --doc:#C7ADE3; --doc-soft:#2D2438;
    --scene:#141B1D; --label-bg:rgba(21,28,30,.9);
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#0F1416; --panel:#151C1E; --ink:#E2E8E6; --muted:#98A5A4; --faint:#6D7A7A;
  --line:#293436; --chip:#1C2528; --accent:#72B4D4; --accent-soft:#1D3441; --accent-ink:#0C1417;
  --warn:#E3A84E; --warn-soft:#3A2C16; --ok:#7CC593; --ok-soft:#1B3223; --info:#A8B4D2; --info-soft:#22283A; --doc:#C7ADE3; --doc-soft:#2D2438;
  --scene:#141B1D; --label-bg:rgba(21,28,30,.9);
}
html,body{height:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:14px;line-height:1.45}
*{box-sizing:border-box}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

.app{display:grid;grid-template-columns:minmax(300px,360px) 1fr;height:100%}
.panel{background:var(--panel);border-right:1px solid var(--line);overflow-y:auto;padding:20px 20px 28px;display:flex;flex-direction:column;gap:22px}
.stage{position:relative;min-height:0;overflow:hidden;background:var(--scene)}
#view{position:absolute;inset:0;display:block;width:100%;height:100%;touch-action:none}
#labels{position:absolute;inset:0;pointer-events:none;overflow:hidden}

/* title block, in the manner of a drawing's title block */
.tb{border:1.5px solid var(--ink);display:grid;grid-template-columns:1fr 1fr}
.tb > div{padding:7px 10px;border-top:1px solid var(--line)}
.tb > div:nth-child(odd){border-right:1px solid var(--line)}
.tb .name{grid-column:1/-1;border-top:0;padding:12px 10px 10px}
.tb h1{font-family:var(--display);font-weight:700;font-size:26px;line-height:1.05;margin:0;letter-spacing:.2px;text-wrap:balance}
.tb .sub{color:var(--muted);margin-top:3px}
.k{display:block;font-family:var(--display);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);font-weight:600}
.v{font-family:var(--mono);font-size:12.5px;font-variant-numeric:tabular-nums}

h2{font-family:var(--display);font-weight:600;font-size:13px;letter-spacing:.1em;text-transform:uppercase;margin:0 0 8px;color:var(--muted)}
.section p{margin:0 0 8px;color:var(--muted);max-width:60ch}

/* rooms table */
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
th{font-family:var(--display);font-weight:600;font-size:12px;letter-spacing:.06em;text-transform:uppercase;text-align:left;color:var(--faint);padding:10px 0 4px;border-bottom:1px solid var(--line)}
td{padding:5px 0;border-bottom:1px solid var(--line)}
td.n{text-align:right;font-family:var(--mono);font-size:12.5px}
tr.room{cursor:pointer}
tr.room:hover td{color:var(--accent)}
tr.room.sel td{color:var(--accent);font-weight:600}
tr.sum td{border-bottom:0;font-weight:600;padding-top:6px}
.sw{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:8px;vertical-align:-1px;border:1px solid rgba(0,0,0,.18)}
.fine{font-size:12.5px;color:var(--faint);margin-top:6px}

/* checks */
.checks{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
.checks li{display:grid;grid-template-columns:auto 1fr;gap:4px 10px;align-items:start}
.pill{font-family:var(--display);font-weight:600;font-size:11px;letter-spacing:.07em;text-transform:uppercase;padding:2px 7px;border-radius:3px;white-space:nowrap;margin-top:1px}
.pill.ok{background:var(--ok-soft);color:var(--ok)}
.pill.warn{background:var(--warn-soft);color:var(--warn)}
.pill.info{background:var(--info-soft);color:var(--info)}
.pill.photo{background:var(--accent-soft);color:var(--accent)}
.pill.doc{background:var(--doc-soft);color:var(--doc)}
.checks b{font-weight:600}
.checks .d{color:var(--muted)}
.checks ul{margin:4px 0 4px;padding-left:18px}
.checks .todo{grid-column:2;font-size:12.5px;color:var(--ink);border-left:2px solid var(--warn);padding-left:8px}

/* measured areas and prospectus facts */
table.bra{margin-top:14px}
.facts{display:grid;grid-template-columns:auto 1fr;gap:8px 12px;margin:0}
.facts dt{font-family:var(--display);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);font-weight:600;padding-top:2px}
.facts dd{margin:0;color:var(--muted)}
.facts ul{margin:4px 0;padding-left:18px}

/* chips and segmented controls */
.chip{border:1px solid var(--line);background:var(--chip);border-radius:4px;padding:5px 9px;cursor:pointer;font-size:13px;line-height:1.2}
.chip:hover{border-color:var(--accent)}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.toolbar{position:absolute;left:12px;right:12px;top:12px;display:flex;flex-wrap:wrap;gap:8px;align-items:flex-start;pointer-events:none}
.toolbar > *{pointer-events:auto}
.seg{display:inline-flex;background:var(--panel);border:1px solid var(--line);border-radius:5px;padding:2px;box-shadow:0 1px 2px rgba(0,0,0,.06)}
.seg button{border:0;background:transparent;padding:5px 10px;border-radius:3px;cursor:pointer;font-size:13px;white-space:nowrap}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
.seg button:not([aria-pressed="true"]):hover{color:var(--accent)}

.compass{position:absolute;right:14px;bottom:14px;width:52px;height:52px;border-radius:50%;background:var(--panel);border:1px solid var(--line);display:grid;place-items:center}
.compass svg{width:40px;height:40px}
.selbox{position:absolute;left:12px;bottom:14px;background:var(--panel);border:1px solid var(--line);border-radius:5px;padding:8px 12px;max-width:min(320px,calc(100% - 90px))}
.selbox .t{font-family:var(--display);font-weight:600;font-size:17px}
.selbox .s{color:var(--muted);font-size:12.5px}

.lbl{position:absolute;left:0;top:0;transform:translate(-50%,-50%);background:var(--label-bg);border:1px solid var(--line);border-radius:3px;padding:1px 6px;white-space:nowrap;font-family:var(--display);font-size:12.5px;font-weight:600;color:var(--ink);line-height:1.3;will-change:transform}
.lbl span{font-family:var(--mono);font-weight:400;font-size:11px;color:var(--muted);margin-left:5px}
.lbl.sel{border-color:var(--accent);color:var(--accent)}

.err{position:absolute;inset:0;display:grid;place-items:center;padding:24px;text-align:center;color:var(--muted)}

@media (max-width:820px){
  html,body{height:auto}
  .app{grid-template-columns:1fr;grid-template-rows:auto auto;height:auto}
  .stage{order:-1;height:62vh;min-height:360px}
  .panel{border-right:0;border-top:1px solid var(--line);overflow:visible;padding:18px 16px 28px}
  .seg button{padding:5px 8px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

