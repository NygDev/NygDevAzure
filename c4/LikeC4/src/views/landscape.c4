views {

  view index {
    title 'The estate — five front doors'
    description '
      Everything a visitor can reach, and what sits behind it. Read it as four
      journeys that share a backend and almost nothing else:

      nygard.dev is a page of links that polls the game server for its
      status. run.nygard.dev is a page that draws one JSON file.
      rpg.nygard.dev is a virtual machine running Foundry VTT. And
      gym.nygard.dev and gymbro.nygard.dev are two front doors on one
      training log — a phone and a desk, one API and one Cosmos partition
      behind them.

      The depth is behind two of them. The running dashboard is a chain the
      API runs on a timer: WHOOP into Cosmos, Cosmos into charts, charts into
      a blob the page fetches directly — `running` opens that up and
      `runningPipeline` is the same thing in order. The training log is the
      other, and what is deep about it is not the shape but the token: it is
      the only thing here with a caller to authenticate, and `gym` is that
      page.

      What builds all of this is left out on purpose — see `delivery`, and
      `rpgTerraform` for the virtual machine specifically. So is Entra, which
      both the gym sign-in and every deploy go through; it is on `gym` and on
      `delivery` rather than crossing this page twice. So is the one-time
      WHOOP consent, which is a person clicking through an OAuth screen once
      and not something any site does; that is `whoopBootstrap`.

      One more leg is left off for readability rather than for altitude: the
      gym pages also fetch the shipped exercise library and day templates off
      the CDN account. Both arrows crossed the page to say something the API
      leg beside them already implies, and both are on `gym`. The one blob
      fetch drawn here is run.nygard.dev, where it is not a detail — it is the
      only thing that page does.
    '

    include
      user,
      web,
      running,
      rpg,
      gym,
      gymbro,
      api,
      integrations,
      cosmos,
      keyvault,
      cdn,
      azadmin,
      whoop

    // The last two are the shipped exercise library and the day templates.
    // Unlike run.nygard.dev, whose only arrow that fetch is, the gym pages
    // read them once and then work off the API — so at this altitude it is a
    // detail, and it cost two arrows across the whole page to say it.
    exclude
      user -> integrations,    // the one-time consent — see `whoopBootstrap`
      cdn.webSite -> user,     // the published diagrams — see `delivery`
      gym -> cdn,              // the shipped library and templates — see `gym`
      gymbro -> cdn

    autoLayout LeftRight 150 110

    // The one box that is not ours
    style whoop {
      color muted
    }
  }

  deployment view azureDeployment {
    title 'Deployment — the whole subscription'
    description '
      Every resource group and what is in it, as terraform provisions it.
      Two nodes sit outside Azure: the visitor browser, where every request
      into the estate starts, and the WHOOP API, the one thing the estate
      calls out to.

      Two things are read rather than owned: the nygdevcdn account, of which
      only the `data` container and the two gym files in it are managed
      here, and the foundrydata disk, which is attached and never created —
      that is what lets rpg-vm be destroyed and rebuilt without losing a
      world. sql-nygdev is the opposite case: owned here, in Sweden Central
      rather than Norway East, and reached by nothing else on the page.
    '

    include
      internet,
      internet.*,
      azure,
      azure.rgConsumption,
      azure.rgConsumption.*,
      azure.rgConsumption.aspDotnet.*,
      azure.rgConsumption.aspPs.*,
      azure.rgDb,
      azure.rgDb.*,
      azure.rgWeb,
      azure.rgWeb.*,
      azure.rgWeb.cdnStorage.*,
      azure.rgNetwork,
      azure.rgNetwork.*,
      azure.rgNetwork.vnetMain.*,
      azure.rgVm,
      azure.rgVm.*,
      azure.rgVm.rpgVm.*,
      azure.rgData,
      azure.rgData.*,
      azure.rgSecurity,
      azure.rgSecurity.*

    // Three legs that belong to one journey each and, drawn here, ran the
    // width of the subscription across everything between them.
    exclude
      internet.browser -> azure.rgConsumption.aspIntegrations.integrationsApp,  // the one-time WHOOP consent — see `whoopBootstrap`
      azure.rgWeb.cdnStorage.webContainer -> internet.browser,    // the published diagrams — see `delivery`
      azure.rgWeb.apex -> azure.rgVm.rpgVm.caddyProc              // the nygard.dev status poll — see `apex`

    autoLayout LeftRight 180 110

    style azure {
      color muted
    }
    style azure.rgVm._, azure.rgNetwork._, azure.rgData._ {
      color indigo
    }
    style azure.rgConsumption._ {
      color primary
    }
    style azure.rgWeb._, azure.rgDb._ {
      color amber
    }
  }
}
