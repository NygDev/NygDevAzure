views {

  view index {
    title 'The estate — five front doors'
    description '
      Everything a visitor can reach, and what sits behind it. Read it as four
      journeys that share a backend and almost nothing else:

      nygard.dev is a page of links that polls the game server for its
      status. run.nygard.dev is a page that draws one JSON file.
      rpg.nygard.dev is a virtual machine running Foundry VTT. And
      gym.nygard.dev and gymbro.nygard.dev are two front doors on one
      training log — a phone and a desk, one API and one Cosmos partition
      behind them.

      The depth is behind two of them. The running dashboard is a chain the
      API runs on a timer: WHOOP into Cosmos, Cosmos into charts, charts into
      a blob the page fetches directly — `running` opens that up and
      `runningPipeline` is the same thing in order. The training log is the
      other, and what is deep about it is not the shape but the token: it is
      the only thing here with a caller to authenticate, and `gym` is that
      page.

      What builds all of this is left out on purpose — see `delivery`, and
      `rpgTerraform` for the virtual machine specifically. So is Entra, which
      both the gym sign-in and every deploy go through; it is on `gym` and on
      `delivery` rather than crossing this page twice. So is the one-time
      WHOOP consent, which is a person clicking through an OAuth screen once
      and not something any site does; that is `whoopBootstrap`.
    '

    include
      user,
      web,
      running,
      rpg,
      gym,
      gymbro,
      api,
      cosmos,
      keyvault,
      cdn,
      azadmin,
      whoop

    exclude
      user -> api,             // the one-time consent — see `whoopBootstrap`
      cdn.webSite -> user      // the published diagrams — see `delivery`

    autoLayout LeftRight 150 110

    // The one box that is not ours
    style whoop {
      color muted
    }
  }

  deployment view azureDeployment {
    title 'Deployment — the whole subscription'
    description '
      Every resource group and what is in it, as terraform provisions it.
      The one node outside Azure is the visitor browser, which is where
      three of these arrows start.

      Two accounts are read rather than owned: nygdevcdn, of which only the
      `data` container and the two gym files in it are managed here, and the
      foundrydata disk, which is attached and never created — that is what
      lets rpg-vm be destroyed and rebuilt without losing a world.
    '

    include
      internet,
      internet.*,
      azure,
      azure.rgConsumption,
      azure.rgConsumption.*,
      azure.rgConsumption.aspDotnet.*,
      azure.rgConsumption.aspPs.*,
      azure.rgDb,
      azure.rgDb.*,
      azure.rgWeb,
      azure.rgWeb.*,
      azure.rgWeb.cdnStorage.*,
      azure.rgNetwork,
      azure.rgNetwork.*,
      azure.rgNetwork.vnetMain.*,
      azure.rgVm,
      azure.rgVm.*,
      azure.rgVm.rpgVm.*,
      azure.rgData,
      azure.rgData.*,
      azure.rgSecurity,
      azure.rgSecurity.*

    autoLayout LeftRight 180 110

    style azure {
      color muted
    }
    style azure.rgVm._, azure.rgNetwork._, azure.rgData._ {
      color indigo
    }
    style azure.rgConsumption._ {
      color primary
    }
    style azure.rgWeb._, azure.rgDb._ {
      color amber
    }
  }
}
