views {

  view delivery {
    title 'Delivery — GitHub to Azure'
    description '
      One question only: which workflow can touch what. Triggers are on
      each workflow, the token exchange is in oidcTrust, and the source
      files that fire each run are in likec4Pipeline — keeping them out of
      here is what makes this readable.
    '

    include
      dev,
      github,
      github.repo,
      github.ghEnv,
      github.actions,
      github.actions.*,
      entra,
      entra.ghOidc,
      azurerm,
      tfstate,
      keyvault,
      azadmin,
      cdn

    // Everything below is true, and belongs in a different view
    exclude
      github.repo.srcWf -> github.actions,   // workflows define themselves
      dev -> cdn.webSite.docs,               // reading the site is not delivery
      entra.ghOidc -> github.actions,        // return leg — see oidcTrust
      entra.ghOidc -> azurerm,               // see oidcTrust
      azurerm -> cdn,                        // provisioning — see index
      azurerm -> azadmin,
      azadmin -> cdn,                        // runtime, not delivery — see cdn
      cdn -> azadmin

    autoLayout LeftRight 160 110

    style * {
      color secondary
    }
    style dev {
      color green
    }
    style github._, github.actions._ {
      color indigo
    }
    style entra._ {
      color amber
    }
    style azurerm, tfstate, keyvault, azadmin, cdn {
      color primary
    }
  }

  view likec4Pipeline {
    title 'LikeC4 — from .c4 text to $web'
    description '
      The one workflow that publishes this site. Editing a .c4 file and
      pushing to master is the whole publishing act; what Deploy LikeC4
      does inside a run is on the element itself.
    '

    include
      dev,
      github,
      github.repo,
      github.repo.srcC4,
      github.ghEnv,
      github.actions,
      github.actions.deployC4,
      entra,
      entra.ghOidc,
      cdn,
      cdn.webSite,
      cdn.webSite.docs,
      user

    autoLayout TopBottom 120 100

    style * {
      color secondary
    }
    style github.actions.deployC4 {
      color indigo
    }
    style github.repo.srcC4 {
      color primary
    }
    style cdn.webSite, cdn.webSite.docs {
      color green
    }
    style dev, user {
      color green
    }
  }

  view oidcTrust {
    title 'Secretless auth — the OIDC exchange'
    description '
      No Azure credential is stored in GitHub. The runner mints a signed
      OIDC token, Entra trades it for an access token, and RBAC on that
      principal is the real blast radius of a compromised workflow.
    '

    include
      github,
      github.actions,
      github.ghEnv,
      entra,
      entra.ghOidc,
      azurerm,
      keyvault,
      tfstate,
      cdn,
      azadmin

    autoLayout LeftRight 180 120

    style * {
      color secondary
    }
    style entra.ghOidc {
      color amber
    }
    style github.actions {
      color indigo
    }
  }

  dynamic view likec4Deploy {
    title 'LikeC4 deploy — step by step'
    description 'A single push to master, followed end to end'

    dev -> github.repo 'Edits a .c4 file and pushes to master'
    github.repo -> github.actions.deployC4 'Path filter c4/LikeC4/** matches; the workflow starts'
    github.ghEnv -> github.actions.deployC4 'Supplies AZURE_CLIENT_ID / TENANT_ID / SUBSCRIPTION_ID'
    github.actions.deployC4 -> entra.ghOidc 'Presents the runner OIDC token'
    entra.ghOidc -> github.actions.deployC4 'Returns a short-lived access token'
    github.actions.deployC4 -> cdn.webSite 'Empties $web, uploads dist/, re-uploads assets/* as immutable'
    cdn.webSite -> user 'Static website hosting serves the new build'

    autoLayout LeftRight
  }
}
