views {

  view delivery {
    title 'Delivery — GitHub to Azure'
    description '
      Every path from this repository into the subscription: what triggers
      each workflow, how a runner gets an Azure token without a stored
      secret, and what it is allowed to touch.
    '

    include
      dev,
      github,
      github.repo,
      github.repo.*,
      github.ghEnv,
      github.actions,
      github.actions.*,
      entra,
      entra.*,
      azurerm,
      tfstate,
      keyvault,
      azadmin,
      cdn,
      cdn.webSite

    exclude
      github.actions.deployC4.*

    autoLayout LeftRight 160 110

    style * {
      color secondary
    }
    style dev {
      color green
    }
    style github._, github.repo._, github.actions._ {
      color indigo
    }
    style entra._ {
      color amber
    }
    style azurerm, tfstate, keyvault, azadmin, cdn, cdn.webSite {
      color primary
    }
  }

  view likec4Pipeline of github.actions.deployC4 {
    title 'LikeC4 — from .c4 text to $web'
    description '
      The one workflow that publishes this site. Ten steps: install,
      validate, render, get a token, empty the container, upload twice
      (once no-cache, once immutable) and print the endpoint.
    '

    include
      *,
      dev,
      github.repo,
      github.repo.srcC4,
      entra.ghOidc,
      cdn,
      cdn.webSite,
      cdn.webSite.docs,
      user

    autoLayout TopBottom 90 90

    style * {
      color secondary
    }
    style github.actions.deployC4._ {
      color indigo
    }
    style github.actions.deployC4.c4Validate, github.actions.deployC4.c4Build {
      color primary
    }
    style cdn.webSite, cdn.webSite.docs {
      color green
    }
    style dev, user {
      color green
    }
  }

  view oidcTrust {
    title 'Secretless auth — the OIDC exchange'
    description '
      No Azure credential is stored in GitHub. The runner mints a signed
      OIDC token, Entra trades it for an access token, and RBAC on that
      principal is the real blast radius of a compromised workflow.
    '

    include
      github,
      github.actions,
      github.ghEnv,
      entra,
      entra.ghOidc,
      azurerm,
      keyvault,
      tfstate,
      cdn,
      azadmin

    autoLayout LeftRight 180 120

    style * {
      color secondary
    }
    style entra.ghOidc {
      color amber
    }
    style github.actions {
      color indigo
    }
  }

  dynamic view likec4Deploy {
    title 'LikeC4 deploy — step by step'
    description 'A single push to master, followed end to end'

    dev -> github.repo 'Edits a .c4 file and pushes to master'
    github.repo -> github.actions.deployC4.c4Checkout 'Path filter c4/LikeC4/** matches; the workflow starts'
    github.actions.deployC4.c4Checkout -> github.actions.deployC4.c4Install 'Setup Node 24, then npm ci'
    github.actions.deployC4.c4Install -> github.actions.deployC4.c4Validate 'likec4 validate — a broken model fails here, before anything is touched'
    github.actions.deployC4.c4Validate -> github.actions.deployC4.c4Build 'Model is valid; likec4 build renders dist/'
    github.ghEnv -> github.actions.deployC4.c4Login 'Supplies AZURE_CLIENT_ID / TENANT_ID / SUBSCRIPTION_ID'
    github.actions.deployC4.c4Login -> entra.ghOidc 'Presents the runner OIDC token'
    entra.ghOidc -> github.actions.deployC4.c4Login 'Returns a short-lived access token'
    github.actions.deployC4.c4Clear -> cdn.webSite 'delete-batch empties $web'
    github.actions.deployC4.c4Upload -> cdn.webSite 'upload-batch dist/, Cache-Control no-cache'
    github.actions.deployC4.c4Immutable -> cdn.webSite 'Re-uploads assets/* as public, max-age=31536000, immutable'
    github.actions.deployC4.c4Report -> dev 'Prints primaryEndpoints.web to the job log'
    cdn.webSite -> user 'Static website hosting serves the new build'

    autoLayout LeftRight
  }
}
