model {

  user = actor 'User' {
    description 'Uses the websites and game server'

    -> web 'Visits (https://nygard.dev)'
    -> running 'Visits (https://run.nygard.dev)'
    -> rpg.client 'Plays on (rpg.nygard.dev)'
  }

  api = function-app 'API' {
    technology '.NET 10 isolated (Flex Consumption)'
    description '
      func-nygdev-api — SpotRead (HTTP, anonymous) point-reads
      a single document out of Cosmos and returns it verbatim.
      Called straight from the run.nygard.dev page, so CORS lists
      that origin and a function key would only sit in public
      JavaScript. Runs as the user-assigned identity id-nygdev-api.
    '
  }

  cosmos = cosmos-db 'Cosmos DB' {
    technology 'Azure Cosmos DB (NoSQL)'
    description '
      nygdev-cosmos-db / db / primary — free tier, indexing_mode "none".
      Point reads only: with no index there is nothing to query against.
    '
  }

  web = static-web-app 'nygard.dev' {
    technology 'Azure Static Web App (Free SKU, westeurope)'
    description '
      Personal apex website (nygdevapex) — free-tier Azure Static Web App.
      Links and Foundry RPG server status.
    '
  }

  running = static-web-app 'run.nygard.dev' {
    technology 'Azure Static Web App (Free SKU, westeurope)'
    description '
      Running/marathon dashboard (nygdevrun) — free-tier Azure Static Web App.
      Provisioned empty by terraform; content deployed from the nygdevweb
      repository. A page with one button that reads the marathon document
      out of Cosmos through the API.
    '
  }

  rpg = virtual-machine 'RPG Server' {
    technology 'Azure Linux VM — Standard_B2s, Ubuntu 26.04 LTS'
    description 'rpg-vm — Ubuntu Linux VM hosting Foundry VTT, behind rpg-pip public IP'

    client = webapp 'FoundryVTT Client' {
      technology 'HTML/JS in browser'
      description 'Foundry game UI running in the browser — served by Foundry VTT on the RPG Server'
    }

    caddy = service 'Caddy' {
      technology 'Caddy'
      description 'Reverse proxy and TLS termination on ports 80/443'
    }

    foundry = service 'Foundry VTT' {
      technology 'Node.js'
      description 'Self-hosted virtual tabletop; serves the game UI and world data'
    }

    client -> caddy 'Connects to (HTTPS/WSS, rpg.nygard.dev)'
    caddy -> foundry 'Reverse proxies to (:30000)'
    foundry -> client 'Serves game UI and world data to'
  }

  cdn = storage-account 'CDN Storage' {
    technology 'Azure Blob Storage — foundry media + $web static website'
    description '
      nygdevcdn storage account — CDN for Foundry media
      (foundry container)
    '
  }

  azadmin = function-app 'Admin Automation' {
    technology 'PowerShell 7.4 (Flex Consumption)'
    description '
      func-nygdev-azadmin — cachecontrol (HTTP) and
      cachecontrolauto (Event Grid) set Cache-Control
      on blobs in the foundry container
    '
  }

  // The fetch runs in the visitor's browser, not on the Static Web App: the
  // free SKU has no linked backend and no proxying, so the page calls the
  // function app cross-origin. Three settings have to name the same origin or
  // the call never leaves the browser — SPOT_URL in main.js, connect-src in
  // staticwebapp.config.json, and the function app's CORS allowed origins.
  running -> api 'Fetches the spot read from the browser (GET /api/spotread, cross-origin)'

  api -> cosmos 'Point-reads id 1 / partition run_marathon (id-nygdev-api)' #managed-identity

  web -> rpg.caddy 'Polls Foundry status (GET /api/status)'
  rpg.foundry -> cdn 'Holds asset URLs pointing to'
  azadmin -> cdn 'Sets Cache-Control on blobs (managed identity)' #managed-identity
  cdn -> azadmin 'Triggers on blob-created events (Event Grid)'
  cdn -> user 'Serves Foundry media to (direct browser fetch)'
}
