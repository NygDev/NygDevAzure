// What runs, and what talks to what. The delivery plane that builds all of it
// is in delivery.c4; where it physically sits is in deployment/.
//
// One convention, used throughout: a Static Web App element stands for the page
// it serves, and an edge drawn from it is a fetch the visitor browser makes.
// All four sites are on the free SKU, which has no linked backend and no
// proxying, so nothing ever runs server-side behind them — every such edge is
// cross-origin from the browser, and the label says so.
model {

  // =======================================================================
  // People
  // =======================================================================

  user = actor 'Visitor' {
    description '
      Reads the sites and plays on the game server. Also the person at the
      WHOOP consent screen, once — a refresh token can be renewed forever,
      but only a human can create the first one.

      On the training log they are more than a reader: they sign in, and the
      Entra object id that comes back is the Cosmos partition every block,
      session and set of theirs is written under.
    '
  }

  dev = actor 'Developer' {
    description 'Authors the model, the terraform and the function code, and pushes to master'
  }

  // =======================================================================
  // The front doors
  // =======================================================================

  web = static-web-app 'nygard.dev' {
    technology 'Azure Static Web App — Free SKU, westeurope'
    description 'nygdevapex. Links, and the live status of the Foundry server.'
  }

  running = static-web-app 'run.nygard.dev' {
    technology 'Azure Static Web App — Free SKU, westeurope'
    description '
      nygdevrun — the running and marathon dashboard. Provisioned empty by
      terraform; content deployed from the nygdevweb repository.

      The page holds no logic of its own worth drawing: it fetches one
      pre-built JSON document from the CDN account and draws the charts in
      it. Nothing is computed here, and no function is called.
    '
  }

  gym = static-web-app 'gym.nygard.dev' {
    technology 'Azure Static Web App — Free SKU, westeurope'
    description '
      nygdevgym — GymLog, the training logger. Provisioned empty by terraform;
      the built React app is deployed from the nygdevweb repository.

      The first page in the estate that signs anybody in. Everything it shows
      belongs to one account, so it holds an MSAL client, signs in against
      Entra as the GymLog registration, and puts the resulting bearer token on
      every call it makes to the API.

      It is also the first page that both fetches a blob and calls a function,
      and the split is deliberate: the exercise library and the built-in day
      templates are the same for every account, so they are anonymous blobs it
      reads once and caches, and only what a person wrote goes through the API.
    '
  }

  gymbro = static-web-app 'gymbro.nygard.dev' {
    technology 'Azure Static Web App — Free SKU, westeurope'
    description '
      nygdevgymbro — the desktop planner for the same training log. A Static
      Web App of its own rather than a path on the logger, because a Static Web
      App routes on path only: a second subdomain with different content needs
      a second resource, which is the same reason there were three already.

      It shares everything but the layout. Same API, same Cosmos partition,
      same GymLog registration — Easy Auth checks which client obtained the
      token, so a planner with a registration of its own would be answered 403
      rather than given a login of its own. What it adds is a screen wide
      enough to write a block on and to read a whole one back off.
    '
  }

  rpg = virtual-machine 'RPG Server' {
    technology 'Azure Linux VM — Standard_B2s, Ubuntu 26.04 LTS minimal'
    description '
      rpg-vm, behind the rpg-pip public IP. Built by terraform and
      configured by cloud-init; worlds and media live on a separate disk
      that survives the VM being rebuilt.
    '

    client = webapp 'Foundry Client' {
      technology 'HTML / JS in the browser'
      description 'The game UI, served by Foundry VTT and running in the player browser'
    }

    caddy = service 'Caddy' {
      technology 'Caddy'
      description 'Reverse proxy and TLS termination on 80/443, for rpg.nygard.dev'
    }

    foundry = service 'Foundry VTT' {
      technology 'Node.js, listening on :30000'
      description 'Self-hosted virtual tabletop, running as srv_foundry off the foundrydata disk'
    }

    client -> caddy 'HTTPS / WSS to rpg.nygard.dev'
    caddy -> foundry 'Reverse proxies to :30000'
    foundry -> client 'Serves the game UI and world data'
  }

  // =======================================================================
  // The backend
  // =======================================================================

  api = function-app 'API' {
    technology '.NET 10 isolated — Flex Consumption'
    description '
      func-nygdev-api. The training log and nothing else since the split:
      blocks, sessions, sets and saved day templates, read and written a tap
      at a time by the two gym front ends. Runs as id-nygdev-api, which is how
      it reaches Cosmos without holding a key or a connection string.

      It used to carry the WHOOP sync and the dashboard build as well, and
      losing them is what let Easy Auth be enforced here. Those two can
      present no token — WHOOP redirects a browser to a callback, the phone
      holds a function key — so while they shared this app the platform gate
      had to stay off and every gym route refused unauthenticated callers for
      itself. They are on Integrations now, and the gate is on:
      require_authentication with Return401, no exempt paths.

      The route-level check stays regardless, because the two answer different
      questions. The gate establishes that a token was valid. The check
      establishes which user it named, and that answer is the Cosmos partition
      key — read from the platform headers and never from a route, a query
      string or a body, because it is the whole tenancy boundary.

      Every write carries the count the client believes the session already
      holds and applies only while that is still true. So a request whose
      reply was lost is safe to send again — it answers "already recorded"
      rather than logging the set twice, which is what makes a one-tap button
      safe to hammer on gym wifi and what lets the page draw the row before
      the call returns.
    '
  }

  integrations = function-app 'Integrations' {
    technology '.NET 10 isolated — Flex Consumption'
    description '
      func-nygdev-integrations. Everything that feeds the estate from outside
      it, split off from the API so that app could have its gate turned on.
      Runs as id-nygdev-integrations, which reaches Cosmos, the vault and the
      CDN account without holding a key or a connection string.

      Two jobs on schedules a quarter of an hour apart, drawn apart on
      purpose: one talks to WHOOP, the other to Cosmos and blob storage, so
      neither failure is reported as the other. Beside them sits the phone
      location spool — /api/gps/locations, a push rather than a schedule,
      writing db/gps.

      No Easy Auth here, and that is the point of the app rather than an
      omission. The WHOOP callback has to be reachable by WHOOP, and the rest
      carry function keys, so there is no token for a gate to validate.
    '

    sync = job 'WHOOP sync' {
      technology 'Timer + HTTP trigger, one shared gate'
      description '
        Walks WHOOP collections into Cosmos. Timer at 00:00, 06:00, 12:00
        and 18:00 UTC; /api/whoop/sync is the same work on demand, and both
        go through one runner holding one gate, so a manual call landing on
        top of the scheduled run stands down rather than racing it.

        The first runs backfill history newest-first on a time budget, each
        picking up where the last stopped. Once a collection runs out of
        history every later run re-reads the last seven days instead —
        WHOOP filters on start time, and a record it rescored keeps the
        start it always had, so a "since last sync" query would never see
        it again.
      '
    }

    dashboard = job 'Dashboard build' {
      technology 'Timer + HTTP trigger'
      description '
        Rebuilds the running dashboard from whatever is stored: pace by run
        type, aerobic efficiency, weekly volume, acute:chronic workload,
        weekly time in zones. Timer at 00:15, 06:15, 12:15 and 18:15 UTC —
        fifteen minutes behind each sync, but not chained to it.

        It only needs the sync to have finished, not to have succeeded,
        because it reads the stored runs rather than that run writes. The
        build is a pure function of those runs and the day, so a slot that
        finds nothing new republishes what is already there.

        /api/running/dashboard is the same build on demand, for a backfill
        (where rebuilding after every sync call would be waste) or for a
        change to the arithmetic, which reshapes the whole history.
      '
    }
  }

  azadmin = function-app 'Admin Automation' {
    technology 'PowerShell 7.4 — Flex Consumption'
    description 'func-nygdev-azadmin. Sets Cache-Control on Foundry media blobs, on demand and on blob-created events.'
  }

  cosmos = cosmos-db 'Cosmos DB' {
    technology 'Azure Cosmos DB (NoSQL) — free tier'
    description '
      nygdev-cosmos-db / db, one account holding three containers that share
      nothing but the throughput. Local auth is off, so Entra role assignments
      are the only way in, and each is scoped to a single container rather than
      to the account: id-nygdev-api reaches `gym` alone, id-nygdev-integrations
      reaches `primary` and `gps`. So neither app can read what the other
      writes, which matters most in one direction — `gym` is partitioned per
      user and is the tenancy boundary.

      `primary` is the WHOOP store, partitioned on /type. `gym` is the
      training log, partitioned on /objectId — the signed-in caller, which is
      what makes the partition key the tenancy boundary rather than a routing
      detail. `gps` is the phone location spool on /sender, with a three-day
      TTL.

      All three are indexed opt-in, /* excluded and only what is filtered on
      included: /sport_name and /score_state on primary, for the dashboard
      build reading scored runs; /type and /mesoId on gym, for History and the
      block map. Excluding is doing the most work on gym, where the sets are
      the bulk of a document and are never filtered on — which is what keeps a
      set-tap costing the same on the thirtieth set as on the first.

      Session consistency, and the training log is what asked for it: log a
      set, re-read the session, and on Eventual the replica that answers may
      not hold it yet. On a single-region account it costs the same RU as
      Eventual.
    '
  }

  keyvault = secret-store 'Key Vault' {
    technology 'Azure Key Vault — standard, RBAC data plane'
    description '
      nygdev, in rg-nygdev-security. Holds whoop-clientsecret, copied in by
      hand from the WHOOP developer dashboard, and whoop-token.

      The second is not configuration. WHOOP rotates the refresh token on
      every use and the API writes the replacement straight back, so this is
      where that state lives between calls — which is why the identity holds
      Secrets Officer here rather than a reader role.

      Terraform Apply also reads HomeIP from here at run time, and the
      nygdev-ed25519 SSH public key sits beside it as its own resource.
    '
  }

  cdn = storage-account 'CDN Storage' {
    technology 'Azure Blob Storage — nygdevcdn'
    description 'One public account serving three unrelated things'

    foundryMedia = blob-container 'foundry' {
      description 'Foundry VTT media, fetched straight by player browsers'
    }

    dataContainer = blob-container 'data' {
      technology 'Anonymous blob read; the container cannot be listed'
      description '
        Three files, published by two different things.

        marathonprep.json is the built running dashboard, written by the
        Integrations app and rewritten in place on every build, carrying a five-minute
        Cache-Control so each rebuild reaches the page well before the next
        one runs.

        gym-exercises.json and gym-templates.json are the exercise library and
        the built-in day templates. They are not written by anything at run
        time — they are files in the repository that terraform uploads, so
        editing one is an apply rather than a deploy. They are here rather
        than in Cosmos because they are identical for every account and change
        when the app ships: served per account they would cost a function
        invocation, a token and an RU to hand back the same objects. Cached
        for a day, which is also the worst case for a new exercise reaching a
        phone that has already loaded the app.

        Anonymous read is what lets all three be fetched with no key, no token
        and no function call in between. The gym fetches deliberately send no
        Authorization header either: adding one would turn a simple
        cross-origin GET into a preflight this endpoint has no CORS rule for.
      '
    }

    webSite = blob-container '$web' {
      technology 'Azure Storage static website hosting'
      description 'This model, rendered by likec4 build and served at the account primary web endpoint'
    }
  }

  whoop = external-system 'WHOOP' {
    technology 'WHOOP API v2 — OAuth 2.0 + REST'
    description '
      Wearable platform, read-only to us and gated by an authorization code
      grant. A person consents once and that yields a refresh token; every
      refresh then rotates it, killing the old one the moment a new one is
      issued. So the replacement has to be captured and stored, or the
      integration locks itself out.
    '
  }

  // The tenant itself is declared in delivery.c4, where it issues the tokens
  // the workflows run as. This is the other half of what it does for us, and
  // it is runtime rather than delivery: the registration a person signs in
  // against on the training log.
  extend entra {
    gymlog = app-registration 'GymLog' {
      technology 'Single-page application platform, no client secret'
      description '
        The identity both gym front ends sign in as, and the identity Easy
        Auth on the API accepts. Both halves of that check name it: the token
        is minted for GymLog, and it was obtained by GymLog.

        The second half is the one with consequences. The platform reads the
        claim naming the client that obtained the token, so a front end given
        a registration of its own is answered 403 rather than quietly working
        — which is why the planner signs in as this registration rather than
        as itself, and why giving it one later is a terraform change and not a
        front-end one.

        Managed by hand, and it is the one thing in journey four that no
        apply can create. Declaring it would mean the azuread provider and a
        Microsoft Graph application grant on the workflow identity, which is a
        much wider permission than one registration justifies. What that costs
        is that the SPA redirect URIs and the exposed scope are portal work;
        terraform prints them as outputs instead.
      '
    }
  }

  // =======================================================================
  // Journey 1 — nygard.dev
  // =======================================================================

  user -> web 'Visits https://nygard.dev'

  // From the browser, not from the Static Web App: see the note at the top.
  web -> rpg.caddy 'Polls the Foundry status from the page (GET /api/status)'

  // =======================================================================
  // Journey 2 — run.nygard.dev, and the WHOOP chain feeding it
  // =======================================================================

  user -> running 'Visits https://run.nygard.dev'

  // Also from the browser, and the reason the `data` container is
  // anonymous-read: there is nothing in this path that could hold a key.
  running -> cdn.dataContainer 'Fetches the built dashboard from the page (GET data/marathonprep.json)'

  // The refresh token is read, spent and rewritten on the same call, which is
  // why the identity holds Secrets Officer here rather than a reader role.
  integrations.sync -> keyvault 'Reads whoop-clientsecret; reads and rewrites the rotating whoop-token' #managed-identity
  integrations.sync -> whoop 'Refreshes the access token, then pages cycles, sleep, workouts and recovery' #scheduled

  // Upserting by WHOOP own id is what makes a re-sync idempotent: a record
  // WHOOP rescored overwrites its earlier self rather than landing beside it.
  // The cursors live in the same container, one document per collection.
  integrations.sync -> cosmos 'Upserts each record on its WHOOP id, and one sync cursor per collection' #managed-identity

  integrations.dashboard -> cosmos 'Queries the scored running workouts back out (the only query in the model)' #managed-identity
  integrations.dashboard -> cdn.dataContainer 'Publishes marathonprep.json (PUT, in place)' #managed-identity

  // Once, by hand. The refresh grant can keep a token pair alive forever but
  // cannot create one — only a person at the consent screen can do that.
  user -> integrations 'Grants WHOOP access, once (GET /api/whoop/authorize)'

  // =======================================================================
  // Journey 3 — rpg.nygard.dev
  // =======================================================================

  user -> rpg.client 'Plays at https://rpg.nygard.dev'
  rpg.foundry -> cdn.foundryMedia 'Holds asset URLs pointing at'
  cdn.foundryMedia -> user 'Serves media straight to the player browser'

  azadmin -> cdn.foundryMedia 'Sets Cache-Control on blobs' #managed-identity
  cdn.foundryMedia -> azadmin 'Blob-created events (Event Grid)'

  // =======================================================================
  // Journey 4 — gym.nygard.dev and gymbro.nygard.dev
  // =======================================================================
  //
  // The one journey with a person in it who is more than a reader, and the
  // only one where two front doors open on the same room: the logger is a
  // phone held in one hand, the planner is the same block on a desk. There is
  // no second API, no second store and no second registration behind them.

  user -> gym 'Logs a session at https://gym.nygard.dev'
  user -> gymbro 'Plans a block at https://gymbro.nygard.dev'

  // From the browser, as everywhere else on this page. MSAL runs in the page,
  // the code exchange is PKCE and there is no client secret anywhere — a SPA
  // that could keep one would not be a SPA.
  gym -> entra.gymlog 'Signs in as this registration (MSAL, authorization code with PKCE)'
  gymbro -> entra.gymlog 'Signs in as the same registration, for the same reason'

  // Cross-origin, which is why both origins are in the CORS list on the
  // function app. The token is what decides whose log is read: nothing in
  // these calls names a user.
  gym -> api 'Reads and writes the training log, one tap at a time' #signed-in
  gymbro -> api 'Reads and writes the same routes, a whole block at a time' #signed-in

  // No token on these two, deliberately: an Authorization header would turn a
  // simple cross-origin GET into a preflight the blob endpoint has no rule for.
  gym -> cdn.dataContainer 'Fetches the exercise library and the built-in day templates, once, and caches them'
  gymbro -> cdn.dataContainer 'Fetches the same two files'

  // Easy Auth in front of every function in the app, and since the split it
  // refuses the request outright rather than passing it through unauthenticated
  // — there is nothing left here that could not present a token.
  api -> entra.gymlog 'Validates the bearer token against this registration, and refuses the request if it does not hold one'

  api -> cosmos 'Reads and writes the blocks, sessions and saved templates in db/gym, under the object id off the token' #managed-identity
}
