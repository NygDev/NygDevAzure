// What runs, and what talks to what. The delivery plane that builds all of it
// is in delivery.c4; where it physically sits is in deployment/.
//
// One convention, used throughout: a Static Web App element stands for the page
// it serves, and an edge drawn from it is a fetch the visitor browser makes.
// Both sites are on the free SKU, which has no linked backend and no proxying,
// so nothing ever runs server-side behind them — every such edge is
// cross-origin from the browser, and the label says so.
model {

  // =======================================================================
  // People
  // =======================================================================

  user = actor 'Visitor' {
    description '
      Reads the sites and plays on the game server. Also the person at the
      WHOOP consent screen, once — a refresh token can be renewed forever,
      but only a human can create the first one.
    '
  }

  dev = actor 'Developer' {
    description 'Authors the model, the terraform and the function code, and pushes to master'
  }

  // =======================================================================
  // The three front doors
  // =======================================================================

  web = static-web-app 'nygard.dev' {
    technology 'Azure Static Web App — Free SKU, westeurope'
    description 'nygdevapex. Links, and the live status of the Foundry server.'
  }

  running = static-web-app 'run.nygard.dev' {
    technology 'Azure Static Web App — Free SKU, westeurope'
    description '
      nygdevrun — the running and marathon dashboard. Provisioned empty by
      terraform; content deployed from the nygdevweb repository.

      The page holds no logic of its own worth drawing: it fetches one
      pre-built JSON document from the CDN account and draws the charts in
      it. Nothing is computed here, and no function is called.
    '
  }

  rpg = virtual-machine 'RPG Server' {
    technology 'Azure Linux VM — Standard_B2s, Ubuntu 26.04 LTS minimal'
    description '
      rpg-vm, behind the rpg-pip public IP. Built by terraform and
      configured by cloud-init; worlds and media live on a separate disk
      that survives the VM being rebuilt.
    '

    client = webapp 'Foundry Client' {
      technology 'HTML / JS in the browser'
      description 'The game UI, served by Foundry VTT and running in the player browser'
    }

    caddy = service 'Caddy' {
      technology 'Caddy'
      description 'Reverse proxy and TLS termination on 80/443, for rpg.nygard.dev'
    }

    foundry = service 'Foundry VTT' {
      technology 'Node.js, listening on :30000'
      description 'Self-hosted virtual tabletop, running as srv_foundry off the foundrydata disk'
    }

    client -> caddy 'HTTPS / WSS to rpg.nygard.dev'
    caddy -> foundry 'Reverse proxies to :30000'
    foundry -> client 'Serves the game UI and world data'
  }

  // =======================================================================
  // The backend
  // =======================================================================

  api = function-app 'API' {
    technology '.NET 10 isolated — Flex Consumption'
    description '
      func-nygdev-api. Runs as the user-assigned identity id-nygdev-api,
      which is how it reaches Cosmos, the vault and the CDN account without
      holding a key or a connection string.

      Two jobs live in it, on two schedules a quarter of an hour apart, and
      they are separate on purpose: one talks to WHOOP, the other to Cosmos
      and blob storage, so neither failure is reported as the other.
    '

    sync = job 'WHOOP sync' {
      technology 'Timer + HTTP trigger, one shared gate'
      description '
        Walks WHOOP collections into Cosmos. Timer at 00:00, 06:00, 12:00
        and 18:00 UTC; /api/whoop/sync is the same work on demand, and both
        go through one runner holding one gate, so a manual call landing on
        top of the scheduled run stands down rather than racing it.

        The first runs backfill history newest-first on a time budget, each
        picking up where the last stopped. Once a collection runs out of
        history every later run re-reads the last seven days instead —
        WHOOP filters on start time, and a record it rescored keeps the
        start it always had, so a "since last sync" query would never see
        it again.
      '
    }

    dashboard = job 'Dashboard build' {
      technology 'Timer + HTTP trigger'
      description '
        Rebuilds the running dashboard from whatever is stored: pace by run
        type, aerobic efficiency, weekly volume, acute:chronic workload,
        weekly time in zones. Timer at 00:15, 06:15, 12:15 and 18:15 UTC —
        fifteen minutes behind each sync, but not chained to it.

        It only needs the sync to have finished, not to have succeeded,
        because it reads the stored runs rather than that run writes. The
        build is a pure function of those runs and the day, so a slot that
        finds nothing new republishes what is already there.

        /api/running/dashboard is the same build on demand, for a backfill
        (where rebuilding after every sync call would be waste) or for a
        change to the arithmetic, which reshapes the whole history.
      '
    }
  }

  azadmin = function-app 'Admin Automation' {
    technology 'PowerShell 7.4 — Flex Consumption'
    description 'func-nygdev-azadmin. Sets Cache-Control on Foundry media blobs, on demand and on blob-created events.'
  }

  cosmos = cosmos-db 'Cosmos DB' {
    technology 'Azure Cosmos DB (NoSQL) — free tier'
    description '
      nygdev-cosmos-db / db / primary, partitioned on /type. Local auth is
      off, so the Entra role assignment for id-nygdev-api is the only way in.

      Indexed opt-in: /* excluded, with /sport_name and /score_state included
      for the one query that exists — the dashboard build reading scored runs
      out of the whoop_workout partition. Everything else is written and read
      by id. Indexing a record in full would be paid on every write of every
      sync to earn nothing.
    '
  }

  keyvault = secret-store 'Key Vault' {
    technology 'Azure Key Vault — standard, RBAC data plane'
    description '
      nygdev, in rg-nygdev-security. Holds whoop-clientsecret, copied in by
      hand from the WHOOP developer dashboard, and whoop-token.

      The second is not configuration. WHOOP rotates the refresh token on
      every use and the API writes the replacement straight back, so this is
      where that state lives between calls — which is why the identity holds
      Secrets Officer here rather than a reader role.

      Terraform Apply also reads HomeIP from here at run time, and the
      nygdev-ed25519 SSH public key sits beside it as its own resource.
    '
  }

  cdn = storage-account 'CDN Storage' {
    technology 'Azure Blob Storage — nygdevcdn'
    description 'One public account serving three unrelated things'

    foundryMedia = blob-container 'foundry' {
      description 'Foundry VTT media, fetched straight by player browsers'
    }

    dashboardData = blob-container 'data' {
      technology 'Anonymous blob read; the container cannot be listed'
      description '
        marathonprep.json — the built running dashboard, rewritten in place
        on every build and carrying a five-minute Cache-Control, so each
        rebuild reaches the page well before the next one runs.

        Anonymous read is what lets run.nygard.dev fetch it with no key, no
        token and no function call in between.
      '
    }

    webSite = blob-container '$web' {
      technology 'Azure Storage static website hosting'
      description 'This model, rendered by likec4 build and served at the account primary web endpoint'
    }
  }

  whoop = external-system 'WHOOP' {
    technology 'WHOOP API v2 — OAuth 2.0 + REST'
    description '
      Wearable platform, read-only to us and gated by an authorization code
      grant. A person consents once and that yields a refresh token; every
      refresh then rotates it, killing the old one the moment a new one is
      issued. So the replacement has to be captured and stored, or the
      integration locks itself out.
    '
  }

  // =======================================================================
  // Journey 1 — nygard.dev
  // =======================================================================

  user -> web 'Visits https://nygard.dev'

  // From the browser, not from the Static Web App: see the note at the top.
  web -> rpg.caddy 'Polls the Foundry status from the page (GET /api/status)'

  // =======================================================================
  // Journey 2 — run.nygard.dev, and the WHOOP chain feeding it
  // =======================================================================

  user -> running 'Visits https://run.nygard.dev'

  // Also from the browser, and the reason the `data` container is
  // anonymous-read: there is nothing in this path that could hold a key.
  running -> cdn.dashboardData 'Fetches the built dashboard from the page (GET data/marathonprep.json)'

  // The refresh token is read, spent and rewritten on the same call, which is
  // why the identity holds Secrets Officer here rather than a reader role.
  api.sync -> keyvault 'Reads whoop-clientsecret; reads and rewrites the rotating whoop-token' #managed-identity
  api.sync -> whoop 'Refreshes the access token, then pages cycles, sleep, workouts and recovery' #scheduled

  // Upserting by WHOOP own id is what makes a re-sync idempotent: a record
  // WHOOP rescored overwrites its earlier self rather than landing beside it.
  // The cursors live in the same container, one document per collection.
  api.sync -> cosmos 'Upserts each record on its WHOOP id, and one sync cursor per collection' #managed-identity

  api.dashboard -> cosmos 'Queries the scored running workouts back out (the only query in the model)' #managed-identity
  api.dashboard -> cdn.dashboardData 'Publishes marathonprep.json (PUT, in place)' #managed-identity

  // Once, by hand. The refresh grant can keep a token pair alive forever but
  // cannot create one — only a person at the consent screen can do that.
  user -> api 'Grants WHOOP access, once (GET /api/whoop/authorize)'

  // =======================================================================
  // Journey 3 — rpg.nygard.dev
  // =======================================================================

  user -> rpg.client 'Plays at https://rpg.nygard.dev'
  rpg.foundry -> cdn.foundryMedia 'Holds asset URLs pointing at'
  cdn.foundryMedia -> user 'Serves media straight to the player browser'

  azadmin -> cdn.foundryMedia 'Sets Cache-Control on blobs' #managed-identity
  cdn.foundryMedia -> azadmin 'Blob-created events (Event Grid)'
}
