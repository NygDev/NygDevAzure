// How text in this repository becomes running Azure resources.
//
// Each workflow is one element. What happens inside a run is described, not
// modelled — steps churn far faster than the shape of the pipeline, and a
// diagram of actions/checkout teaches nobody anything.
//
// terraform-import.yml is deliberately absent: it is a one-shot migration that
// adopts two hand-made resources into state and is meant to be deleted once it
// has run, not a pipeline.
//
// terraform-apply-gymbro.yml is absent for a different reason: it is the same
// configuration under -target, so it can touch nothing Terraform Apply cannot
// and a box for it would answer the same question twice. What is worth knowing
// about it — that the narrower blast radius is the whole point, and what
// -target leaves out — is on tfApply below.
//
// So is the nygdevweb repository. The four sites are provisioned empty here and
// their content is deployed from there, on pipelines of their own; this file is
// about what turns text in *this* repository into Azure.
model {

  github = external-system 'GitHub' {
    technology 'github.com'
    description 'Source of truth and CI/CD control plane for the whole estate'

    repo = repository 'NygDevAzure' {
      description 'Single repository; master is the deploy branch'

      srcC4 = source-files 'c4/LikeC4/**' {
        technology 'LikeC4 DSL'
        description 'This model — specification, logical model, delivery, deployment and views'
      }

      srcTf = source-files 'terraform/**' {
        technology 'Terraform HCL'
        description 'The Azure estate: resource groups, VNet, VM, storage, Cosmos, function apps, Key Vault'
      }

      srcApi = source-files 'apifunctionapp/**' {
        technology 'C# / .NET 10 isolated worker'
        description 'The WHOOP endpoints, the two timers, the running dashboard build, the gym routes and the GPS upload'
      }

      // Not code, and not deployed by a code pipeline: two JSON files that
      // terraform uploads to the CDN. That is the whole reason they are drawn
      // apart from srcApi — editing an exercise ships through an apply, and a
      // reader who assumed otherwise would look for it in the wrong workflow.
      srcGym = source-files 'gym/**' {
        technology 'JSON, uploaded as blobs'
        description 'The gym exercise library and the built-in day templates — the part of the training log that is the same for every account'
      }

      srcPs = source-files 'psfunctionapp/**' {
        technology 'PowerShell 7.4'
        description 'cachecontrol and cachecontrolauto'
      }
    }

    ghEnv = ci-environment 'Environment "NygDevAzure"' {
      technology 'GitHub Actions environment'
      description '
        AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID,
        AZURE_KEYVAULT_NAME, AZURE_VM_USERNAME, ENTRA_OWNER_OBJECTID.
        Identifiers only — no credential is stored here.
      '
    }

    actions = ci-platform 'GitHub Actions' {
      technology 'ubuntu-latest hosted runners'
      description '
        Every job declares id-token write and contents read, and
        authenticates to Azure with azure/login@v3 over OIDC.
      '

      deployC4 = workflow 'Deploy LikeC4' {
        technology 'deploy-likec4.yml — push to master on c4/LikeC4/**'
        description '
          Installs from the lockfile, runs likec4 validate (a broken model
          fails the run before anything is touched), renders with likec4
          build, then empties $web and uploads dist/ twice — everything as
          no-cache, then assets/* again as immutable.

          Concurrency group deploy-likec4 with cancel-in-progress false,
          because the delete-then-upload sequence must not interleave.
        '
      }

      deployApi = workflow 'Deploy API Function App' {
        technology 'deploy-api-function-app.yml — push to master on apifunctionapp/**'
        description 'dotnet publish -c Release, then Azure/functions-action@v1 to func-nygdev-api. A build failure stops the run before Azure is touched.'
      }

      deployFunc = workflow 'Deploy PS Function App' {
        technology 'deploy-ps-function-app.yml — push to master on psfunctionapp/**'
        description 'Save-Module bundles Az.Accounts and Az.Storage into the package, then Azure/functions-action@v1 to func-nygdev-azadmin.'
      }

      tfApply = workflow 'Terraform Apply' {
        technology 'terraform-apply.yml — workflow_dispatch only'
        description '
          Authenticates with ARM_USE_OIDC, fetches the home IP and the SSH
          public key at run time, then terraform apply -auto-approve.

          Run by hand rather than on a push: there is no plan step and no
          approval gate, so dispatching it is the decision point. Everything
          this configuration manages can be recreated without data loss —
          the Foundry disk and the Cosmos account are read or adopted, not
          replaced. State is serialised by a terraform-apply concurrency
          group.

          It also uploads the two gym JSON files, which is why editing an
          exercise is an apply rather than a deploy: the provider notices the
          checksum change and reuploads the blob.

          terraform-apply-gymbro.yml is the same configuration run under
          -target for the planner Static Web App and the API app alone, so a
          front-end change need not put the VM and the SQL server in its blast
          radius. It plans before it applies, and it is narrower rather than
          different — the caveat is that -target excludes dependents, so the
          two role assignments hanging off the API app are not in its graph.
          A plan there showing the app or its identity being replaced is the
          signal to run this one instead.
        '
      }
    }
  }

  entra = identity-provider 'Microsoft Entra ID' {
    description '
      The tenant behind both kinds of token in this estate: the short-lived
      Azure access tokens the workflows run as, and the bearer tokens a person
      signs in for on the training log. The registration for the second is
      declared with journey four in model.c4.
    '

    ghOidc = app-registration 'GitHub deploy identity' {
      technology 'Workload identity federation'
      description '
        The AZURE_CLIENT_ID principal. Federated credentials trust
        token.actions.githubusercontent.com for this repository and the
        NygDevAzure environment, so there is no client secret to leak.
        Managed outside terraform — it is the identity terraform runs as,
        and RBAC on it is the real blast radius of a compromised workflow.
      '
    }
  }

  azurerm = external-system 'Azure Resource Manager' {
    technology 'management.azure.com'
    description 'The Azure control plane. Terraform and the az CLI both reach the estate through it.'
  }

  tfstate = storage-account 'Terraform State' {
    technology 'Azure Blob Storage, AzureAD auth'
    description 'nygdevtfstate / tfstate / azure-infrastructure.tfstate in rg-nygdev-data'
  }

  // --- source to pipeline ------------------------------------------------
  dev -> github.repo 'git push (master)'

  github.repo.srcC4 -> github.actions.deployC4 'Change here runs' #ci
  github.repo.srcApi -> github.actions.deployApi 'Change here runs' #ci
  github.repo.srcPs -> github.actions.deployFunc 'Change here runs' #ci
  github.repo.srcTf -> github.actions.tfApply 'Change here is applied by' #ci
  github.repo.srcGym -> github.actions.tfApply 'Change here is uploaded by' #ci

  github.ghEnv -> github.actions 'Supplies tenant, subscription and client ids to' #ci

  // --- pipeline to identity ----------------------------------------------
  github.actions -> entra.ghOidc 'Presents the runner OIDC token (azure/login@v3)' #oidc
  entra.ghOidc -> github.actions 'Issues a short-lived Azure access token to' #oidc
  entra.ghOidc -> azurerm 'Authorises calls against (RBAC on the subscription)'

  // --- pipeline to Azure -------------------------------------------------
  github.actions.deployC4 -> cdn.webSite 'Clears and re-uploads dist/ (az storage blob upload-batch)'
  github.actions.deployApi -> api 'Deploys the published worker'
  github.actions.deployFunc -> azadmin 'Deploys the function package'
  github.actions.tfApply -> keyvault 'Reads HomeIP and the SSH public key at run time'
  github.actions.tfApply -> tfstate 'Locks and writes state'
  github.actions.tfApply -> azurerm 'terraform apply -auto-approve'

  // --- what an apply builds ----------------------------------------------
  azurerm -> rpg 'Creates rpg-vm and its NIC, the public IP, the VNet, subnet and NSG, and attaches the foundrydata disk'
  azurerm -> web 'Creates the nygdevapex Static Web App'
  azurerm -> running 'Creates the nygdevrun Static Web App'
  azurerm -> gym 'Creates the nygdevgym Static Web App'
  azurerm -> gymbro 'Creates the nygdevgymbro Static Web App'
  azurerm -> api 'Creates func-nygdev-api, id-nygdev-api, its Cosmos and blob role assignments, the CORS list naming all four site origins, the Easy Auth block, and the app settings the WHOOP code reads'
  azurerm -> azadmin 'Creates func-nygdev-azadmin and its blob role assignment'
  azurerm -> cosmos 'Creates the account, the database, the three containers and their indexing policies'
  azurerm -> cdn.dataContainer 'Creates the data container and uploads the two gym JSON files (the account around it is read, not owned)'
  azurerm -> keyvault 'Creates the vault and the SSH public key resource — but none of the secrets'

  // --- the published result ----------------------------------------------
  cdn.webSite -> user 'Serves the rendered diagrams (account primary web endpoint)'
  dev -> cdn.webSite 'Reviews the rendered model on'
}
