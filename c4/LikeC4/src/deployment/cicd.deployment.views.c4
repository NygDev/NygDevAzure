views {

  deployment view deliveryDeployment {
    title 'Deployment / Delivery'
    description '
      The runner is the only thing outside Azure that can change the
      estate, and it exists for the length of one job.
    '

    include
      githubCloud,
      githubCloud.**,
      internet.browser,
      azure,
      azure.rgWeb,
      azure.rgWeb.cdnStorage,
      azure.rgWeb.cdnStorage.webContainer,
      azure.rgWeb.cdnStorage.webContainer.*,
      azure.rgConsumption,
      azure.rgConsumption.aspPs,
      azure.rgConsumption.aspPs.azadminApp,
      azure.rgSecurity,
      azure.rgSecurity.kv

    autoLayout LeftRight 170 120

    style * {
      color secondary
    }
    style azure {
      color muted
    }
    style githubCloud._, githubCloud.runner._ {
      color indigo
    }
    style azure.rgWeb.cdnStorage.webContainer, azure.rgWeb.cdnStorage.webContainer._ {
      color green
    }
  }
}
