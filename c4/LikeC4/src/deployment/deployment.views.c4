views {

  deployment view azureDeployment {
    title 'Deployment / Azure'
    description '
      Physical layout of the estate: resource groups, Flex Consumption
      plans, VNet/VM and storage, as provisioned by terraform.
    '

    include
      azure,
      azure.**,
      internet.*

    exclude
      azure.** -> internet.entraId,
      azure.rgWeb.cdnStorage.pwaFiles -> azure.rgConsumption.aspDotnet.loggerApi,
      azure.rgWeb.cdnStorage.cdnBlob -> internet.browser,
      internet.browser -> azure.rgVm.**

    autoLayout LeftRight 200 130

    style azure {
      color muted
    }
    style azure.rgVm._, azure.rgNetwork._, azure.rgData._ {
      color indigo
    }
    style azure.rgConsumption._ {
      color green
    }
    style azure.rgWeb._, azure.rgDb._ {
      color amber
    }
  }

  deployment view gymDeployment {
    title 'Deployment / Gym Logger'
    description 'Where each Gym Logger container runs'

    include
      internet.browser,
      internet.entraId,
      azure,
      azure.rgWeb,
      azure.rgWeb.cdnStorage._,
      azure.rgConsumption,
      azure.rgConsumption.aspDotnet._,
      azure.rgDb._

    exclude
      azure.rgWeb.cdnStorage.cdnBlob <-> azure.rgConsumption,
      internet.browser -> azure.rgWeb,
      internet.browser -> azure

    autoLayout TopBottom 130 130

    style * {
      color secondary
    }
    style azure {
      color muted
    }
    style azure.rgConsumption.aspDotnet.loggerApi, azure.rgWeb.cdnStorage.pwaFiles, azure.rgDb.cosmos {
      color primary
    }
    style internet.browser {
      color green
    }
  }

  deployment view foundryDeployment {
    title 'Deployment / Foundry VTT'
    description '
      The FoundryVTT chain: browser via rpg-pip to Caddy, the Foundry
      process on rpg-vm, its dedicated data disk and media CDN.
    '

    include
      internet.browser,
      azure,
      azure.rgNetwork._,
      azure.rgVm._,
      azure.rgVm.rpgVm._,
      azure.rgData._,
      azure.rgWeb,
      azure.rgWeb.cdnStorage,
      azure.rgWeb.cdnStorage.cdnBlob

    exclude
      internet.browser -> azure.rgWeb,
      internet.browser -> azure.rgWeb.cdnStorage,
      azure.rgWeb -> azure.rgVm.rpgVm.caddyProc,
      azure.rgWeb.cdnStorage -> internet

    autoLayout TopBottom 130 130

    style * {
      color secondary
    }
    style azure {
      color muted
    }
    style azure.rgVm.rpgVm.caddyProc, azure.rgVm.rpgVm.foundryProc, azure.rgData.foundryData {
      color primary
    }
    style internet.browser {
      color green
    }
  }
}
