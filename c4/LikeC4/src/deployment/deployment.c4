deployment {

  internet = internet 'Internet' {
    browser = instanceOf user {
      style {
        size sm
        color green
      }
    }
  }

  azure = subscription 'Azure Subscription' {
    description 'Managed by terraform — norwayeast unless noted'

    rgConsumption = resource-group 'rg-nygdev-consumption' {
      description 'Serverless compute, shared monitoring and deploy storage'

      aspDotnet = service-plan 'asp-nygdev-flex-dotnet' {
        technology 'FC1 / Linux'
        apiApp = instanceOf api {
          description 'func-nygdev-api — 512 MB instances, empty (no code deployed)'
        }
      }

      aspPs = service-plan 'asp-nygdev-flex-ps' {
        technology 'FC1 / Linux'
        azadminApp = instanceOf azadmin {
          description 'func-nygdev-azadmin — 512 MB instances'
        }
      }

      funcStorage = blob-storage 'nygdevfunc' {
        description 'Deployment packages (azadmin-deploy, api-deploy containers)'
      }

      appInsights = monitoring 'appi-nygdev-consumption' {
        description 'Application Insights, backed by log-nygdev-consumption workspace'
      }
    }

    rgDb = resource-group 'rg-nygdev-db' {
      cosmosDb = instanceOf cosmos {
        title 'nygdev-cosmos-db'
        description 'GlobalDocumentDB / db / primary container'
      }
    }

    rgWeb = resource-group 'rg-nygdev-web' {
      description 'Web front-ends (Static Web App in westeurope, Free SKU)'

      apex = static-site 'nygdevapex' {
        description 'Serves https://nygard.dev'
        webapex = instanceOf web
      }

      cdnStorage = blob-storage 'nygdevcdn' {
        cdnBlob = instanceOf cdn
      }
    }

    rgNetwork = resource-group 'rg-nygdev-network' {
      pip = public-ip 'rpg-pip' {
        description 'Static public IP, DNS label "rpg"'
      }

      vnetMain = vnet 'nygdev-vnet' {
        subnetRpg = subnet 'rpg-snet' {
          description 'NSG nygdev-nsg: 80/443 from anywhere; 22/30000/30001 from home IP only'
        }
      }
    }

    rgVm = resource-group 'rg-nygdev-vm' {
      rpgVm = vm 'rpg-vm' {
        technology 'Standard_B2s, Ubuntu 26.04 LTS minimal'
        description '
          30 GB os disk + foundrydata data disk (persistent, in rg-nygdev-data);
          auto-shutdown 23:00 Oslo time
        '

        caddyProc = instanceOf rpg.caddy
        foundryProc = instanceOf rpg.foundry
      }
    }

    rgData = resource-group 'rg-nygdev-data' {
      description 'Persistent data — survives VM rebuilds'

      foundryData = disk 'foundrydata' {
        technology 'Azure Managed Disk'
        description 'Dedicated data disk for Foundry VTT worlds, modules and media'
      }
    }

    rgSecurity = resource-group 'rg-nygdev-security' {
      description 'Not created by terraform — managed as minimal definitions'

      kv = key-vault 'nygdev' {
        description 'Secrets; alongside the nygdev-ed25519 SSH public key resource'
      }
    }
  }

  internet.browser -> azure.rgNetwork.pip 'HTTPS to rpg.nygard.dev (rpg.norwayeast.cloudapp.azure.com)'
  azure.rgNetwork.pip -> azure.rgVm.rpgVm.caddyProc 'Forwards 80/443 via rpg-snet'
  azure.rgVm.rpgVm.foundryProc -> azure.rgData.foundryData 'Stores worlds, modules and media on (attached data disk)'
  azure.rgConsumption.aspDotnet.apiApp -> azure.rgConsumption.appInsights 'Telemetry (OpenTelemetry)'
  azure.rgConsumption.aspPs.azadminApp -> azure.rgConsumption.appInsights 'Telemetry'
}
