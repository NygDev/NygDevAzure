// Where every element in the logical model physically sits, as terraform
// provisions it. Names here are the real Azure resource names.
deployment {

  internet = internet 'Internet' {
    browser = instanceOf user {
      title 'Visitor browser'
      style {
        size sm
        color green
      }
    }

    whoopApi = instanceOf whoop {
      title 'api.prod.whoop.com'
      description 'The OAuth token endpoint and the v2 data API, both outside the subscription'
    }
  }

  azure = subscription 'Azure Subscription' {
    description 'Managed by terraform — norwayeast unless noted'

    rgConsumption = resource-group 'rg-nygdev-consumption' {
      description 'Serverless compute, shared monitoring and deploy storage'

      // One plan per app because Flex Consumption allows exactly one, not
      // because the runtimes differ — the runtime is set on the app. So the
      // split of func-nygdev-api into two apps was also a third plan.
      aspDotnet = service-plan 'asp-nygdev-flex-dotnet' {
        technology 'FC1 / Linux'

        apiApp = instanceOf api {
          title 'func-nygdev-api'
          description '
            512 MB instances, max 1. Runs as id-nygdev-api. CORS allows gym
            and gymbro, each under its custom domain and its default hostname.
            Easy Auth enforces GymLog tokens: require_authentication with
            Return401 and no exempt paths, which is what moving the anonymous
            callers off this app bought.
          '
        }
      }

      aspIntegrations = service-plan 'asp-nygdev-flex-integrations' {
        technology 'FC1 / Linux'

        integrationsApp = instanceOf integrations {
          title 'func-nygdev-integrations'
          description '
            512 MB instances, max 1. Runs as id-nygdev-integrations. No CORS
            list and no Easy Auth: nothing that calls it is a browser holding
            a token — the WHOOP callback is a top-level redirect and the rest
            carry function keys.
          '
        }
      }

      aspPs = service-plan 'asp-nygdev-flex-ps' {
        technology 'FC1 / Linux'

        azadminApp = instanceOf azadmin {
          title 'func-nygdev-azadmin'
          description '512 MB instances, max 1. System-assigned identity.'
        }
      }

      funcStorage = blob-storage 'nygdevfunc' {
        description 'Deployment packages — the azadmin-deploy, api-deploy and integrations-deploy containers'
      }

      appInsights = monitoring 'appi-nygdev-consumption' {
        description 'Application Insights, backed by the log-nygdev-consumption workspace'
      }
    }

    rgDb = resource-group 'rg-nygdev-db' {
      cosmosDb = instanceOf cosmos {
        title 'nygdev-cosmos-db'
        description 'GlobalDocumentDB, free tier, local auth disabled, Session consistency — db / primary, gym and gps'
      }

      // Nothing in the logical model talks to it, which is why it is only
      // here: it is a resource terraform owns, not a part of any journey.
      sqlServer = sql-server 'sql-nygdev' {
        technology 'Azure SQL — swedencentral'
        description '
          Sweden Central, because the free Azure SQL offer is not available
          in Norway East. Entra-only authentication and a firewall open to
          the home IP alone. The free-tier database inside it was made by hand
          and is deliberately not managed here.
        '
      }
    }

    rgWeb = resource-group 'rg-nygdev-web' {
      description 'Web front-ends. The Static Web Apps are in westeurope, Free SKU.'

      apex = static-site 'nygdevapex' {
        description 'Serves https://nygard.dev'
        webApex = instanceOf web
      }

      runDash = static-site 'nygdevrun' {
        description 'Serves https://run.nygard.dev'
        webRun = instanceOf running
      }

      gymSite = static-site 'nygdevgym' {
        description 'Serves https://gym.nygard.dev'
        webGym = instanceOf gym
      }

      // A fourth resource rather than a path on the third: a Static Web App
      // routes on path only, so a second subdomain with different content has
      // to be a second app.
      gymbroSite = static-site 'nygdevgymbro' {
        description 'Serves https://gymbro.nygard.dev'
        webGymbro = instanceOf gymbro
      }

      // The account itself is read by terraform, not owned by it; only the
      // `data` container below is managed here.
      cdnStorage = blob-storage 'nygdevcdn' {
        mediaContainer = storage-container 'foundry' {
          mediaBlobs = instanceOf cdn.foundryMedia
        }

        dataContainer = storage-container 'data' {
          dataBlobs = instanceOf cdn.dataContainer
        }

        webContainer = storage-container '$web' {
          siteBlobs = instanceOf cdn.webSite
        }
      }
    }

    rgNetwork = resource-group 'rg-nygdev-network' {
      pip = public-ip 'rpg-pip' {
        description 'Static public IP, DNS label "rpg" — rpg.norwayeast.cloudapp.azure.com'
      }

      vnetMain = vnet 'nygdev-vnet' {
        technology '10.0.0.0/24'

        subnetRpg = subnet 'rpg-snet' {
          technology '10.0.0.0/29'
          description 'NSG nygdev-nsg: 80/443 from anywhere; 22, 30000 and 30001 from the home IP only'
        }
      }
    }

    rgVm = resource-group 'rg-nygdev-vm' {
      rpgVm = vm 'rpg-vm' {
        technology 'Standard_B2s, Ubuntu 26.04 LTS minimal'
        description '
          30 GB StandardSSD OS disk, SSH key only, no VM agent and no
          extensions. Configured entirely by cloud-init; auto-shutdown at
          23:00 Oslo time.
        '

        caddyProc = instanceOf rpg.caddy
        foundryProc = instanceOf rpg.foundry
      }
    }

    rgData = resource-group 'rg-nygdev-data' {
      description 'Persistent data — survives VM rebuilds'

      foundryData = disk 'foundrydata' {
        technology 'Azure Managed Disk, attached at LUN 0'
        description '
          Worlds, modules, media, the Caddyfile and the Foundry install.
          Referenced by terraform as a data source and attached, never
          created — which is what lets the VM be destroyed and rebuilt.
        '
      }
    }

    rgSecurity = resource-group 'rg-nygdev-security' {
      description 'The resource group is not created by this configuration; the vault in it is'

      kv = key-vault 'nygdev' {
        description 'RBAC data plane. Holds HomeIP, whoop-clientsecret and whoop-token, alongside the nygdev-ed25519 SSH public key resource.'
      }
    }
  }

  // --- what a visitor reaches --------------------------------------------
  internet.browser -> azure.rgWeb.apex 'HTTPS to nygard.dev'
  internet.browser -> azure.rgWeb.runDash 'HTTPS to run.nygard.dev'
  internet.browser -> azure.rgWeb.gymSite 'HTTPS to gym.nygard.dev'
  internet.browser -> azure.rgWeb.gymbroSite 'HTTPS to gymbro.nygard.dev'
  internet.browser -> azure.rgNetwork.pip 'HTTPS to rpg.nygard.dev'

  // The anonymous reads off the `data` container are not declared here. They
  // arrive from the logical model, drawn from each site the way every other
  // browser call in it is: run.nygard.dev fetching marathonprep.json, and the
  // two gym front ends fetching the exercise library and the day templates.
  // A second copy from the browser node said the same thing and had to loop
  // round the whole subscription to say it.
  //
  // The one browser call in the estate that carries a token. Both origins are
  // in the CORS list on the app, and the platform validates the token before
  // any function runs.
  azure.rgWeb.gymSite -> azure.rgConsumption.aspDotnet.apiApp 'Calls /gym cross-origin with a bearer token'
  azure.rgWeb.gymbroSite -> azure.rgConsumption.aspDotnet.apiApp 'The same routes, from the planner'

  // --- inside ------------------------------------------------------------
  azure.rgNetwork.pip -> azure.rgVm.rpgVm.caddyProc 'Forwards 80/443 through rpg-snet'
  azure.rgVm.rpgVm.foundryProc -> azure.rgData.foundryData 'Stores worlds, modules and media on the attached disk'

  azure.rgConsumption.aspDotnet.apiApp -> azure.rgDb.cosmosDb 'HTTPS/443, gateway mode, Entra token for id-nygdev-api — scoped to db/gym alone'

  azure.rgConsumption.aspIntegrations.integrationsApp -> azure.rgDb.cosmosDb 'HTTPS/443, gateway mode, Entra token for id-nygdev-integrations — one grant each on db/primary and db/gps, and none on db/gym'
  azure.rgConsumption.aspIntegrations.integrationsApp -> azure.rgSecurity.kv 'HTTPS/443, Entra token for id-nygdev-integrations'
  azure.rgConsumption.aspIntegrations.integrationsApp -> azure.rgWeb.cdnStorage.dataContainer 'Publishes marathonprep.json as id-nygdev-integrations'
  azure.rgConsumption.aspIntegrations.integrationsApp -> internet.whoopApi 'OAuth token grants and v2 reads'

  azure.rgConsumption.aspDotnet.apiApp -> azure.rgConsumption.appInsights 'Telemetry (OpenTelemetry)'
  azure.rgConsumption.aspIntegrations.integrationsApp -> azure.rgConsumption.appInsights 'Telemetry, to the same workspace'
  azure.rgConsumption.aspPs.azadminApp -> azure.rgConsumption.appInsights 'Telemetry'
}
