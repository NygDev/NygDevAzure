// The delivery plane: how text in this repository becomes running Azure
// resources. Derived from .github/workflows/*.yml.
//
// Each workflow is one element. What happens inside a run is described, not
// modelled — steps change far more often than the shape of the pipeline.
model {

  dev = actor 'Developer' {
    description '
      Authors the LikeC4 model, the terraform configuration and the
      function code, and pushes to master
    '
  }

  github = external-system 'GitHub' {
    technology 'github.com'
    description 'Source of truth and CI/CD control plane for the whole estate'

    repo = repository 'NygDevAzure' {
      description 'Single repository; master is the deploy branch'

      srcC4 = source-files 'c4/LikeC4/src/**/*.c4' {
        technology 'LikeC4 DSL'
        description '
          The architecture model as plain text — the specification,
          the logical model, the deployment model and the views
        '
      }

      srcTf = source-files 'terraform/**/*.tf' {
        technology 'Terraform HCL'
        description 'The Azure estate: resource groups, VNet, VM, storage, function apps'
      }

      srcPs = source-files 'psfunctionapp/**' {
        technology 'PowerShell 7.4'
        description 'cachecontrol and cachecontrolauto function code'
      }

      srcWf = source-files '.github/workflows/*.yml' {
        technology 'YAML'
        description 'The three workflows that deploy everything above'
      }
    }

    ghEnv = ci-environment 'Environment "NygDevAzure"' {
      technology 'GitHub Actions environment'
      description '
        AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID,
        AZURE_KEYVAULT_NAME, AZURE_VM_USERNAME, ENTRA_OWNER_OBJECTID.
        Identifiers only — no credential is stored here.
      '
    }

    actions = ci-platform 'GitHub Actions' {
      technology 'ubuntu-latest hosted runners'
      description '
        Every job declares permissions: id-token write, contents read,
        and authenticates to Azure with azure/login@v3 over OIDC
      '

      deployC4 = workflow 'Deploy LikeC4' {
        technology '.github/workflows/deploy-likec4.yml'
        description '
          Trigger: push to master touching c4/LikeC4/**, or workflow_dispatch.

          Installs from the lockfile, runs likec4 validate (a broken model
          fails the run before anything is touched), renders the site with
          likec4 build, logs in over OIDC, then empties $web and uploads
          dist/ twice — everything as no-cache, then assets/* again as
          immutable. Finishes by printing primaryEndpoints.web.

          concurrency group deploy-likec4 with cancel-in-progress false,
          because the delete-then-upload sequence must not interleave.
        '
      }

      deployFunc = workflow 'Deploy PS Function App' {
        technology '.github/workflows/deploy-ps-function-app.yml'
        description '
          Trigger: push to master touching psfunctionapp/**, or
          workflow_dispatch.

          Save-Module bundles Az.Accounts and Az.Storage into the package,
          then Azure/functions-action@v1 pushes it to func-nygdev-azadmin.
        '
      }

      tfApply = workflow 'Terraform Apply' {
        #manual
        technology '.github/workflows/terraform-apply.yml'
        description '
          Trigger: workflow_dispatch only — never on push. There is no
          plan-on-PR workflow, so the diff is only ever seen in this run.

          Authenticates with ARM_USE_OIDC, fetches the home IP and the SSH
          public key at run time, then terraform apply -auto-approve.
        '
      }
    }
  }

  entra = identity-provider 'Microsoft Entra ID' {
    description 'Tenant that issues the access tokens the workflows use'

    ghOidc = app-registration 'GitHub deploy identity' {
      technology 'Workload identity federation'
      description '
        The AZURE_CLIENT_ID principal. Federated credentials trust
        token.actions.githubusercontent.com for this repository and the
        NygDevAzure environment, so no client secret exists to leak.
        Managed outside terraform — it is the identity terraform runs as.
      '
    }
  }

  azurerm = external-system 'Azure Resource Manager' {
    technology 'management.azure.com'
    description '
      The Azure control plane. Terraform and the az CLI both reach the
      estate through it; RBAC on this principal is what bounds a workflow.
    '
  }

  tfstate = storage-account 'Terraform State' {
    technology 'Azure Blob Storage, AzureAD auth'
    description '
      nygdevtfstate / tfstate / azure-infrastructure.tfstate in
      rg-nygdev-data — the backend Terraform Apply locks and writes
    '
  }

  keyvault = secret-store 'Key Vault' {
    description '
      nygdev in rg-nygdev-security — holds the HomeIP secret and, beside
      it, the nygdev-ed25519 SSH public key resource
    '
  }

  // ---------------------------------------------------------------------
  // nygdevcdn serves two very different things out of one storage account
  // ---------------------------------------------------------------------
  extend cdn {

    foundryMedia = blob-container 'foundry' {
      description 'Foundry VTT media, fetched straight by players browsers'
    }

    webSite = blob-container '$web' {
      technology 'Azure Storage static website hosting'
      description '
        The static-website container. Its contents are served at the
        account primary web endpoint, reported at the end of every deploy.
      '

      docs = webapp 'LikeC4 Site' {
        technology 'Static HTML + JS, produced by likec4 build'
        description 'The browsable diagrams — this model, rendered'
      }
    }
  }

  // --- source to pipeline ------------------------------------------------
  dev -> github.repo 'git push (master)'
  dev -> github.actions.tfApply 'Starts by hand (workflow_dispatch)' #manual
  github.repo.srcWf -> github.actions 'Defines the workflows of' #ci

  github.repo.srcC4 -> github.actions.deployC4 'Change here runs' #ci
  github.repo.srcPs -> github.actions.deployFunc 'Change here runs' #ci
  github.repo.srcTf -> github.actions.tfApply 'Applied by (no automatic trigger)' #manual

  github.ghEnv -> github.actions 'Supplies tenant, subscription and client ids to' #ci

  // --- pipeline to identity ---------------------------------------------
  github.actions -> entra.ghOidc 'Presents the runner OIDC token (azure/login@v3)' #oidc
  entra.ghOidc -> github.actions 'Issues a short-lived Azure access token to' #oidc
  entra.ghOidc -> azurerm 'Authorises calls against (RBAC on the subscription)'

  // --- pipeline to Azure -------------------------------------------------
  github.actions.deployC4 -> cdn.webSite 'Clears and re-uploads dist/ (az storage blob upload-batch)'
  github.actions.deployFunc -> azadmin 'Deploys the function package (Azure/functions-action@v1)'
  github.actions.tfApply -> keyvault 'Reads HomeIP and the SSH public key'
  github.actions.tfApply -> tfstate 'Locks and writes state'
  github.actions.tfApply -> azurerm 'Creates and updates the estate (terraform apply -auto-approve)'

  // --- what terraform builds --------------------------------------------
  azurerm -> cdn 'Provisions and configures'
  azurerm -> azadmin 'Provisions and configures'

  // --- the published result ---------------------------------------------
  cdn.webSite.docs -> user 'Serves rendered diagrams to (primary web endpoint)'
  dev -> cdn.webSite.docs 'Reviews the rendered model on'
}
