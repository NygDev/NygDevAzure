<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ships the worker telemetry to the same Application Insights resource
         the host writes to, reading APPLICATIONINSIGHTS_CONNECTION_STRING out
         of the app settings exactly as the old SDK did. The exporter, not the
         Azure.Monitor.OpenTelemetry.AspNetCore distro: the distro turns on
         ASP.NET Core instrumentation, and since the host already emits a
         request per invocation, every call would be reported twice. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- The WHOOP client secret and refresh token live in the nygdev vault;
         the app reads both and writes the refresh token back on every
         rotation, as id-nygdev-integrations. -->
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <!-- The running dashboard is published as a JSON blob on nygdevcdn, which
         the run.nygard.dev page fetches directly. Written as the app's managed
         identity — the account holds no key this app is given. -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <!-- Referenced although this project carries no timer function yet, and
         that absence is deliberate rather than pending: while apifunctionapp
         still holds the same code, a WhoopSyncTimer here would be a second one
         firing on the same schedule against one WHOOP refresh token. The lease
         the extension takes is scoped to an app, so it would not coordinate
         the two. WhoopSyncTimer.cs and RunningDashboardTimer.cs are the last
         two files to copy, at the cutover, when the originals are deleted in
         the same commit — the reference is here so that is a file move and not
         a packages change too. -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <!-- Teaches the OpenTelemetry pipeline about the worker: it activates the
         invocation ActivitySource and stamps the trace context the host
         propagates onto the worker's spans, which is what keeps a function's
         host-side request and its own logs under one operation. -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.OpenTelemetry" Version="1.2.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <!-- Microsoft.Azure.Cosmos still uses Newtonsoft.Json internally and, since
         3.62, requires the consumer to reference it explicitly rather than
         pulling it in transitively. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Brings AddOpenTelemetry() and the hosted service that owns the tracer
         and logger providers, so they are started and flushed with the host. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
