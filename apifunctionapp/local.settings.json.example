{
  "IsEncrypted": false,
  "Values": {
    "_comment_storage": "No trigger in this app takes a blob lease any more — the timers left with WHOOP and the running dashboard — so the gym endpoints run locally without an Azurite instance behind this value. The host still wants the setting present.",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "COSMOS_ENDPOINT": "https://nygdev-cosmos-db.documents.azure.com:443/",

    "_comment_gym": "The gym endpoints identify the caller from the principal Easy Auth builds, and there is no Easy Auth in front of `func start` — so without this every one of them answers 401 locally. Set it to your own Entra object id: it is the Cosmos partition key, so this is which training log you are reading and writing. It is consulted only when the platform sent no principal, and terraform never sets it on the function app; setting it there by hand would hand one user's log to every anonymous caller.",
    "GYM_LOCAL_OBJECT_ID": "00000000-0000-0000-0000-000000000000"
  }
}
