<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Nothing here formats or compares by culture — every parse is
         InvariantCulture and every comparison ordinal — so the runtime can skip
         loading ICU at startup, which is time a quarter-core instance spends
         before the first request can be answered. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- packages.lock.json pins every package, transitive ones included, and
         is what the deploy workflow keys its NuGet cache on — so a restore
         that has nothing new to fetch is answered from the cache.

         RuntimeIdentifiers (plural) makes every restore include the linux-x64
         graph that publishing uses, without making a local build
         RID-specific. Without it the lock file has one shape after a local
         restore and another after a publish, and each rewrites the other. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Cold start, and publish-only so a local build and func start stay
       portable.

       Flex Consumption bills an instance's activity at a minimum of one second
       and by the 100 ms after that, so a warm call costs the same whether it
       takes 40 ms or 900. What costs more than the floor is the first call
       after an idle spell, and on a 512 MB instance — a quarter of a core —
       most of that is the JIT compiling the Cosmos SDK, Azure.Identity and the
       ASP.NET Core pipeline. ReadyToRun ships that code precompiled.

       The runtime identifier is what ReadyToRun needs, and it also drops the
       Cosmos SDK's Windows-only native binaries — ServiceInterop and the VC
       runtime, about 18 MB that can never load on Linux — from the package the
       instance fetches before it starts. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ships the worker telemetry to the same Application Insights resource
         the host writes to, reading APPLICATIONINSIGHTS_CONNECTION_STRING out
         of the app settings exactly as the old SDK did. The exporter, not the
         Azure.Monitor.OpenTelemetry.AspNetCore distro: the distro turns on
         ASP.NET Core instrumentation, and since the host already emits a
         request per invocation, every call would be reported twice. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <!-- Teaches the OpenTelemetry pipeline about the worker: it activates the
         invocation ActivitySource and stamps the trace context the host
         propagates onto the worker's spans, which is what keeps a function's
         host-side request and its own logs under one operation. -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.OpenTelemetry" Version="1.2.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <!-- Microsoft.Azure.Cosmos still uses Newtonsoft.Json internally and, since
         3.62, requires the consumer to reference it explicitly rather than
         pulling it in transitively. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Brings AddOpenTelemetry() and the hosted service that owns the tracer
         and logger providers, so they are started and flushed with the host. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
